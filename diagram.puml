@startuml
title Todo 프로젝트 핵심 구조 (Spring Boot + MyBatis)

skinparam classAttributeIconSize 0

' ===== Controller =====
class TodoController {
    - TodoService todoService
    + list()
    + registerForm()
    + save()
    + detail()
    + modifyForm()
    + update()
    + delete()
    + getTodoStats()
    + updateStatus()
}

class HomeController {
    - TodoService todoService
    + home()
}

class KanbanController {
    - TodoService todoService
    + kanban()
}

class CalendarController {
    - CalendarService calendarService
    - TodoService todoService
    + calendar()
}

class UserController {
    - UserService userService
    + joinForm()
    + join()
    + loginForm()
    + accessDenied()
}

class FileController {
    + getFile()
}

' ===== Service =====
interface TodoService {
    + saveTodo()
    + getTodoList()
    + getTodo()
    + updateTodo()
    + deleteTodo()
    + getTotalCount()
    + getTodoStats()
    + getAllTodoByUser()
    + updateStatus()
}

class TodoServiceImpl {
    - TodoMapper todoMapper
    - FileStorageUtil fileStorageUtil
    - getOwnedTodo()
    - saveAndUpdateFile()
}

interface CalendarService {
    + getEvents()
}

class CalendarServiceImpl {
    - OAuth2AuthorizedClientService authorizedClientService
}

interface UserService {
    + joinUser()
}

class UserServiceImpl {
    - UserMapper userMapper
    - PasswordEncoder passwordEncoder
}

class FileStorageUtil {
    + storeFile()
    + deleteFile()
}

' ===== Mapper (MyBatis) =====
interface TodoMapper {
    + insertTodo()
    + selectTodoList()
    + selectTodoById(todo_id, user_no)
    + updateTodo()
    + updateTodoFile()
    + deleteTodoFile()
    + deleteTodo()
    + getTotalCount()
    + selectStatusCountByUser()
    + selectAllTodoByUser()
}

interface UserMapper {
    + insertUser()
    + selectUserById()
    + selectUserByNo()
    + countUserById()
}

' ===== Security =====
class CustomUserDetailsService {
    - UserMapper userMapper
}

class CustomOAuth2UserService {
    - UserMapper userMapper
    - PasswordEncoder passwordEncoder
}

' ===== Domain =====
class Todo {
    - Long todo_id
    - Long user_no
    - String user_id
    - String title
    - String content
    - Date schedule_date
    - String status
    - String file_url
    - String file_name
}

class User {
    - Long user_no
    - String user_id
    - String pwd
    - String user_name
    - UserRole role
}

enum UserRole {
    USER
    ADMIN
}

' ===== DTO =====
class TodoSaveRequestDto
class TodoUpdateRequestDto
class TodoResponseDto
class PageRequestDTO {
    - int page
    - int amount
    - String keyword
}
class TodoStatsDTO {
    - long total_count
    - double completion_rate
}
class GoogleEventDto

' 의존 및 연관 관계 표현 (자동으로 화살표가 배치됩니다)
TodoController o-- TodoService : 의존(DI)
HomeController o-- TodoService : 의존(DI)
KanbanController o-- TodoService : 의존(DI)
CalendarController o-- CalendarService : 의존(DI)
CalendarController o-- TodoService : 의존(DI)
UserController o-- UserService : 의존(DI)

TodoServiceImpl ..|> TodoService : 구현
CalendarServiceImpl ..|> CalendarService : 구현
UserServiceImpl ..|> UserService : 구현

TodoServiceImpl o-- TodoMapper : 의존(DI)
TodoServiceImpl o-- FileStorageUtil : 의존(DI)
UserServiceImpl o-- UserMapper : 의존(DI)
CustomUserDetailsService o-- UserMapper : 의존(DI)
CustomOAuth2UserService o-- UserMapper : 의존(DI)

TodoMapper ..> Todo : 조회/저장
UserMapper ..> User : 조회/저장
User --> UserRole

TodoServiceImpl ..> TodoSaveRequestDto : 사용
TodoServiceImpl ..> TodoUpdateRequestDto : 사용
TodoServiceImpl ..> TodoResponseDto : 반환
TodoServiceImpl ..> PageRequestDTO : 사용
TodoServiceImpl ..> TodoStatsDTO : 반환
CalendarServiceImpl ..> GoogleEventDto : 반환

@enduml